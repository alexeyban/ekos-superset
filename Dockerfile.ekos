# EKOS Superset: the official image with the EKOS text-to-SQL / text-to-dashboard module overlaid.
# The frontend is the official prebuilt one; this module is Python and one server-rendered page,
# so no frontend build is needed.
ARG SUPERSET_VERSION=4.1.1
FROM apache/superset:${SUPERSET_VERSION}
USER root
RUN pip install --no-cache-dir psycopg2-binary
COPY superset/ekos_ai /app/superset/ekos_ai
COPY superset/initialization/__init__.py /app/superset/initialization/__init__.py
USER superset
